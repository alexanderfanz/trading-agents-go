{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "publishCmd": "printf '%s' \"$SEMANTIC_RELEASE_NEXT_RELEASE_NOTES\" > .release-notes.md && goreleaser release --release-notes .release-notes.md --clean"
      }
    ]
  ]
}
